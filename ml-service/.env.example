# ML Service Configuration
# Copy this file to .env and fill in real values before running the service.

# REQUIRED: Set a strong, random secret here (e.g. `openssl rand -hex 32`).
# The service will refuse to start if this is missing or left as the placeholder.
API_KEY=change-me-use-a-strong-random-secret

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Model paths and defaults (relative to ml-service root)
MODELS_DIR=models/saved
REPORTS_DIR=reports
DATA_DIR=data
DEFAULT_BUSINESS_ID=biz_001
# Comma-separated list of tenant IDs this key may access. Leave empty to allow all (dev only).
ALLOWED_BUSINESS_IDS=biz_001
