# ==========================================
# Django Application Configuration (.env.example)
# Copy this file to .env and fill in your values.
# Generate a secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ==========================================

# Django core
SECRET_KEY=
DEBUG=True

# Supabase PostgreSQL Database Settings
# Find these in Supabase dashboard -> Settings -> Database
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ==========================================
# ML Microservice Integration (Milestone 2)
# ==========================================
# Base URL of the FastAPI ML service (default: local dev)
ML_SERVICE_URL=http://127.0.0.1:8001

# REQUIRED: must match API_KEY in ml-service/.env
# Generate: openssl rand -hex 32
ML_SERVICE_API_KEY=

# Optional: request timeout in seconds (default: 4.0)
ML_SERVICE_TIMEOUT=4.0
